// Sentinel Server: администраторы компьютера (группа sudo/admin), сидящие за ним, запускают,
// останавливают и перезапускают службу из значка в трее без ввода пароля.
// Настройки и пароли по-прежнему спрашивают пароль (действие io.sentinel.server.configure).
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "sentinel-server.service" &&
        subject.local && subject.active &&
        (subject.isInGroup("sudo") || subject.isInGroup("admin") || subject.isInGroup("wheel"))) {
        var verb = action.lookup("verb");
        if (verb == "start" || verb == "stop" || verb == "restart") {
            return polkit.Result.YES;
        }
    }
});
