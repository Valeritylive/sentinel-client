[Desktop Entry]
Type=Application
Name=Sentinel PRO Server (tray)
Name[ru]=Sentinel PRO Server (значок в трее)
Comment[ru]=Состояние сервера Sentinel PRO в трее
Exec=/usr/bin/sentinel-server-tray
Icon=io.sentinel.Server
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=3
